<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Guillan Loyola — Architecture & Interior Design</title>
  <meta name="description" content="Selected architectural work by Guillan Loyola. Tropical architecture, high-end residential, hospitality and resort design. Senior Architect and Revit BIM Designer." />
  <meta name="theme-color" content="#efede7" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'%3E%3Crect width='80' height='80' fill='%232c342b'/%3E%3Ctext x='12' y='52' font-family='serif' font-size='36' fill='%23efede7'%3EGL%3C/text%3E%3C/svg%3E" />
 </head>
 <body>
  <a class="skip" href="#main">Skip to content</a>
  <header><a href="#" class="brand" aria-label="Guillan Loyola home"><span class="brand-name">GUILLAN LOYOLA</span><span class="brand-subtitle">ARCHITECTURE & INTERIOR DESIGN</span></a><nav aria-label="Main navigation"><a href="#work">Selected work <span>{String(projects.length).padStart(2, '0')}</span></a><a href="#about">About</a><a href="https://www.linkedin.com/in/guiloyola/" target="_blank" rel="noopener noreferrer">Let’s connect ↗</a></nav></header>
  <main id="main">
   <section class="hero" aria-labelledby="hero-title">
    <div class="eyebrow"><span>INDEPENDENT ARCHITECT</span><span>PORTFOLIO / 2026</span></div>
    <h1 id="hero-title">Thoughtful spaces.<br /><em>Natural connections.</em></h1>
    <div class="hero-bottom"><p>Architecture shaped by place,<br />and the people who call it home.</p><a class="round-link" href="#work"><span>Explore selected work</span><b aria-hidden="true">↓</b></a></div>
    <figure class="hero-image"><img src="/images/project-1.jpg" alt="Tropical architectural project by Guillan Loyola" fetchpriority="high" /><figcaption><span>01 / TROPICAL ARCHITECTURE</span><span>FORM IN DIALOGUE WITH NATURE</span></figcaption></figure>
   </section>
   <section id="work" class="work"><div class="section-heading"><h2>Selected work<span>({projects.map(project => project.id).join(' / ')})</span></h2><p>Different settings.<br />One considered approach.</p></div>
    {projects.map(project => <article class="project" id={`project-${project.id}`}>
     <div class="project-top"><span class="number">/{project.id}</span><h3>{project.title}</h3><span class="project-type">{project.type}</span></div>
     <div class="project-gallery" role="region" aria-roledescription="carousel" aria-label={`${project.title} gallery`}>
      <div class="gallery-track" tabindex={project.images.length > 1 ? 0 : undefined} aria-label="Project images">
       {project.images.map((image, index) => <figure class="gallery-slide" role="group" aria-roledescription="slide" aria-label={`Image ${index + 1} of ${project.images.length}`}><img src={image} alt={`${project.title} — view ${index + 1}`} loading="lazy" /></figure>)}
      </div>
      <div class="gallery-controls" hidden={project.images.length < 2}><div class="gallery-arrows"><button class="gallery-prev" aria-label="Previous image"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m14 7-5 5 5 5" /></svg></button><button class="gallery-next" aria-label="Next image"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 7 5 5-5 5" /></svg></button></div><div class="gallery-dots">{project.images.map((_, index) => <button aria-label={`Show image ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'} data-slide={index}></button>)}</div><span class="gallery-count" aria-live="polite" aria-atomic="true">01 / {String(project.images.length).padStart(2, '0')}</span></div>
     </div>
     <div class="project-bottom"><span>{project.id === '05' ? 'INTERIOR DESIGN / SELECTED PROJECT' : 'ARCHITECTURE / SELECTED PROJECT'}</span><p>{project.description}</p></div>
    </article>)}
   </section>
   <section id="about" class="about"><span class="eyebrow">BEHIND THE WORK</span><div><h2 class="serif-heading" style="font-family: 'Libre Caslon Display', Georgia, serif; font-weight: 400; font-style: normal;">A considered approach.<br />From vision to detail.</h2><p>I’m Guillan Loyola, a Senior Architect and Revit BIM Designer working as an independent contractor with US and Australian teams.</p><p>My work explores the relationship between site, space, and daily life — across tropical homes, high-end residences, and hospitality destinations.</p><div class="services"><span>Architectural design</span><span>Revit & BIM</span><span>US / AU collaboration</span></div></div></section>
   <section id="contact" class="contact"><div class="eyebrow">START A CONVERSATION</div><h2 class="serif-heading" style="font-family: 'Libre Caslon Display', Georgia, serif; font-weight: 400; font-style: normal;">Good spaces begin<br />with a connection.</h2><p>For project enquiries and collaboration, connect with me on LinkedIn.</p><a href="https://www.linkedin.com/in/guiloyola/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span>↗</span></a></section>
  </main>
  <footer><span>© {new Date().getFullYear()} Guillan Loyola</span><span>DESIGNED WITH INTENTION.</span><a href="#">Back to top ↑</a></footer>
  <script>
   document.querySelectorAll<HTMLElement>('.project-gallery').forEach(gallery => {
    const track = gallery.querySelector<HTMLElement>('.gallery-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.gallery-slide'));
    if (slides.length < 2) return;
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const previous = gallery.querySelector<HTMLButtonElement>('.gallery-prev')!;
    const next = gallery.querySelector<HTMLButtonElement>('.gallery-next')!;
    let active = 0;
    function goTo(index: number) {
     const target = slides[Math.max(0, Math.min(index, slides.length - 1))];
     track.scrollTo({left: target.offsetLeft - slides[0].offsetLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    }
    function update() {
     active = slides.reduce((best, slide, index) => Math.abs(slide.offsetLeft - slides[0].offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - slides[0].offsetLeft - track.scrollLeft) ? index : best, 0);
     dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === active)));
     const dotStrip = gallery.querySelector<HTMLElement>('.gallery-dots')!;
     dotStrip.scrollLeft = dots[active].offsetLeft - dotStrip.clientWidth / 2 + dots[active].offsetWidth / 2;
     previous.disabled = active === 0; next.disabled = active === slides.length - 1;
     gallery.querySelector('.gallery-count')!.textContent = `${String(active + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    }
    previous.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));
    track.addEventListener('scroll', update, {passive: true});
    track.addEventListener('keydown', event => {
     if (event.target !== track) return;
     if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); goTo(active + (event.key === 'ArrowRight' ? 1 : -1)); }
    });
    new ResizeObserver(() => { goTo(active); update(); }).observe(track);
    update();
   });
  </script>
 </body>
</html>
